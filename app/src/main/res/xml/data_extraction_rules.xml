<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Strict allow-list: back up/transfer only settings.json (excludes crash logs & lockout prefs) -->
    <cloud-backup>
        <include domain="file" path="datastore/settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.json" />
    </device-transfer>
</data-extraction-rules>
