    <!-- System permission descriptions -->
    <string name="accessibility_permission_app_blocker">
        Curbstomp uses Accessibility to:\n1. Detect when you open an app and enforce block/allow rules\n2. Send you home when a blocked app is opened during a rule or focus session\n3. Protect Curbstomp from being force-stopped or uninstalled\n\n
        All processing happens on your device. No data is collected or transmitted.
    </string>
    <string name="admin_permission_desc">Curbstomp Anti-Uninstall Protection</string>
    <string name="admin_permission_explanation">Required to prevent the app from being uninstalled or force-stopped.</string>

    <!-- Main dashboard: Protection toggles -->
    <string name="toggle_force_kill_title">Force Kill on Expiry</string>
    <string name="toggle_force_kill_desc">Required to automatically close blocked apps when their limit is reached or during Instant Focus. Requires Accessibility permission.</string>
    <string name="toggle_uninstall_invincibility_title">Uninstall Invincibility</string>
    <string name="toggle_uninstall_invincibility_desc">Prevents bypassing restrictions by blocking unauthorized uninstallation of Curbstomp. Requires Device Admin permission.</string>
    <string name="toggle_extra_harden_title">Extra Harden (Block Settings)</string>
    <string name="toggle_extra_harden_desc">Completely blocks the Settings app at all times. Prevents any settings modifications.</string>

